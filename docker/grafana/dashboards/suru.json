      "type": "stat",
      "title": "Bildirim kanalı",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-suru"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-suru"
          },
          "query": "from(bucket: \"bulut\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"bildirim\" and r._field == \"adet\")\n  |> group(columns: [\"kanal\"])\n  |> count()\n  |> group()\n  |> map(fn: (r) => ({ _time: now(), kanal: r.kanal, _value: r._value }))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"kanal\"], valueColumn: \"_value\")\n  |> drop(columns: [\"_time\"])"
        }
      ],
      "description": "Push mobil uygulamaya gider. SMS yalnızca uygulaması olmayan mal sahiplerine gider; bölge ölçeğinde maliyetin büyük kısmı SMS'tir (rapor Bölüm 7.2).",
      "gridPos": {
        "x": 16,
        "y": 33,
        "w": 8,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
