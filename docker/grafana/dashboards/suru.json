    {
      "id": 4,
      "type": "text",
      "title": "Bu pano",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**\"sis\"** kovası sabit sis düğümünün yerel ham verisidir. **\"bulut\"** kovası yalnızca acil olayları ve günlük özetleri tutar. Alttaki iki grafik, aynı sürü için klasik yöntemin ve Uyuyan Bulut'un buluta göndereceği mesaj ve veri miktarını karşılaştırır (logaritmik eksen)."
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Buluta giden mesaj (toplam)",
      "description": "Klasik yöntemde her okuma ve kapı geçişi ayrı mesajdır.",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-suru"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-suru"
          },
          "query": "from(bucket: \"sis\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"olcut\" and r.agil == \"agil-sim\" and (r._field == \"klasik_mesaj\" or r._field == \"uyuyan_mesaj\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> map(fn: (r) => ({ r with _field: if r._field == \"klasik_mesaj\" then \"Klasik: her kayıt ayrı mesaj\" else \"Uyuyan Bulut: acil + günlük özet\" }))"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Klasik.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8091a5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Uyuyan.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a9d7f"
                }
              }
            ]
          }
        ]
      }
    },
