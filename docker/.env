# Gösterim ayarları. Bu değerler yalnızca yerel bilgisayarda çalışan kavram kanıtı içindir;
# gerçek kurulumda güçlü parola ve rastgele token kullanılmalı, bu dosya paylaşılmamalıdır.
INFLUX_KULLANICI=suru
INFLUX_SIFRE=suru-yerel-2026
